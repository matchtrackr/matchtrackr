# Copy this file to .env and fill in the values.
# Never commit .env — it's gitignored.

# Which analyzer to use: "mock" (free, fake data) or "gemini" (real, costs money)
ANALYZER=mock

# Required only when ANALYZER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gmail account that SENDS the report email.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Display name used in the From: header of outgoing emails
FROM_NAME=MatchTrackr

# Gemini model id (only used when ANALYZER=gemini)
GEMINI_MODEL=gemini-2.5-flash
